# Copy this file to .env and fill in real values. Never commit .env.

# --- Coinbase Developer Platform (CDP) wallet — step 1 ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# --- Lithic (virtual card issuing) — step 2 ---
LITHIC_API_KEY=

# --- Claude API (agent reasoning) — step 3 ---
ANTHROPIC_API_KEY=

# --- Guardrails — step 5 ---
PAYMENT_PER_TX_CAP_USD=2
PAYMENT_DAILY_CAP_USD=10
# Required to run the UI - it's the dashboard's HTTP Basic Auth password
# (any username works). The UI refuses to serve without this set, since it
# can trigger real payments. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
TRIGGER_API_KEY=

# --- Hosting (optional, only needed when self-hosting) ---
# Root dir for the SQLite audit log and generated PDFs. Point this at a
# mounted persistent disk when hosted; leave unset for local dev.
AGENTIC_PAYMENTS_DATA_DIR=
